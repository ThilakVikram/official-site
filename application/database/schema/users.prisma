// An application account. Only users with isAdmin = true can open /admin.
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  userName     String    @unique
  name         String?
  // argon2id hash (PHC string); the plain password is never stored.
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("users")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256
// hash is stored here, so a leaked table can't be used to sign in.
model Session {
  id        String   @id @db.Char(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}
